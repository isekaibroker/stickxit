# Public site origin used by production metadata and signed wallet messages.
NEXT_PUBLIC_SITE_URL=https://stickxit.com

# Robinhood Chain mainnet is live. The collection mint remains closed until its contract is published.
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain
NEXT_PUBLIC_CHAIN_RPC_URLS=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_CHAIN_EXPLORER_URLS=https://robinhoodchain.blockscout.com
NEXT_PUBLIC_NATIVE_CURRENCY_NAME=Ether
NEXT_PUBLIC_NATIVE_CURRENCY_SYMBOL=ETH
NEXT_PUBLIC_NATIVE_CURRENCY_DECIMALS=18

# ERC-721 collection used for wallet balance checks. Requires NEXT_PUBLIC_CHAIN_ID.
NEXT_PUBLIC_ISEKAI_COLLECTION_ADDRESS=

# Reserved for a future audited on-chain license or staking implementation. Unused before launch.
NEXT_PUBLIC_STAKING_CONTRACT_ADDRESS=
