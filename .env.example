# Public site origin used by production metadata and signed local-access messages.
NEXT_PUBLIC_SITE_URL=

# Set a target EVM chain to enforce network switching. Leave blank for local preview mode.
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_CHAIN_NAME=
NEXT_PUBLIC_CHAIN_RPC_URLS=
NEXT_PUBLIC_CHAIN_EXPLORER_URLS=
NEXT_PUBLIC_NATIVE_CURRENCY_NAME=
NEXT_PUBLIC_NATIVE_CURRENCY_SYMBOL=
NEXT_PUBLIC_NATIVE_CURRENCY_DECIMALS=18

# ERC-721 collection used for wallet balance checks. Requires NEXT_PUBLIC_CHAIN_ID.
NEXT_PUBLIC_ISEKAI_COLLECTION_ADDRESS=

# Reserved for a future audited on-chain license/staking implementation; unused by this MVP.
NEXT_PUBLIC_STAKING_CONTRACT_ADDRESS=
